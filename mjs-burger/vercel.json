{
  "framework": null,
  "buildCommand": "echo static",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/_/index.html" },
    { "source": "/reviews", "destination": "/succesverhalen/index.html" },
    { "source": "/our-story", "destination": "/over-ons/index.html" },
    { "source": "/book", "destination": "/reserveren/index.html" },
    { "source": "/burger-foodtruck", "destination": "/pizza-foodtruck/index.html" },
    { "source": "/tenders-foodtruck", "destination": "/pasta-foodtruck/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_external/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
